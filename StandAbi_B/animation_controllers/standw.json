{
	"format_version": "1.8.0",
	"animation_controllers": {
		"controller.animation.standw":{
			"states":{
				"base_jeta":{
					"transitions":[
						{"wa":"query.is_using_item && !query.is_sneaking && query.get_equipped_item_name=='standw'"},
						{"wb":"query.is_using_item && query.is_sneaking && query.get_equipped_item_name=='standw'"}
					]
				},
				"wa": {
					"transitions": [
							{
								"base_jeta": "(1.0)"
							}
					],
					"on_entry": [
						"/give @s snowball"
					]
				},
				"wb": {
					"transitions": [
							{
								"base_jeta": "(1.0)"
							}
					],
					"on_entry": [
						"/function hf",
						"/damage @e[rm=1,r=20,type=!item,type=!player] 20"
					]
				}
			}
		}
 	}
 }